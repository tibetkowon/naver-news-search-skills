# 네이버 개발자 센터 (https://developers.naver.com) 에서 발급
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Notion (https://www.notion.so/my-integrations) 에서 발급
NOTION_API_KEY=your_notion_api_key

# Slack Incoming Webhook URL. Webhook이 연결된 채널로 발행됩니다.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Discord 채널 설정 > 연동 > Webhooks에서 발급
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Slack/Discord 외 서비스가 {"text":"..."} JSON payload를 받을 때 사용
WEBHOOK_URL=https://example.com/webhook
